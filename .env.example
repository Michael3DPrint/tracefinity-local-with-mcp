# Copy to .env and adjust. All values have working defaults, so an empty .env is fine.

# Host port for the Tracefinity web UI + API.
TRACEFINITY_PORT=3000

# Bind address. 127.0.0.1 = this machine only (default). 0.0.0.0 = reachable from
# other devices on your LAN (e.g. phone uploads). This tool has NO authentication,
# so 0.0.0.0 means every device on the network can read/wipe all data — only do it
# on a network you control. See README "Security".
TRACEFINITY_BIND=127.0.0.1

# Leave this as `open`. This overlay is a single-user local/LAN tool with no login.
# The image's `native` mode (accounts + login + 2FA) is not supported here.
TRACEFINITY_AUTH_MODE=open

# App-side upload cap in MB. The image's bundled nginx caps request bodies at 25 MB
# regardless; this overlay is fixed at that ceiling. (Phone photos are 2-8 MB.)
TRACEFINITY_MAX_UPLOAD_MB=20

# Base URL the MCP server uses to reach Tracefinity (used by scripts/install-mcp.sh).
TRACEFINITY_BASE_URL=http://localhost:3000
